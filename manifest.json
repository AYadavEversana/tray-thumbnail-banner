{
	"manifest_version": 3,
	"name": "Tray Thumbnail Downloader",
	"version": "1.5.0",
	"description": "Download TheBrief ISI tray thumbnails, run QA and rendering self-checks, and audit every brand's trays.",
	"permissions": [
		"downloads",
		"clipboardWrite",
		"storage"
	],
	"host_permissions": [
		"<all_urls>"
	],
	"background": {
		"service_worker": "background.js"
	},
	"content_scripts": [
		{
			"matches": [
				"file:///*toptobottomviewer*",
				"*://*/*toptobottomviewer*"
			],
			"all_frames": true,
			"run_at": "document_idle",
			"js": [
				"vendor/html2canvas.min.js",
				"checks.js",
				"content.js"
			]
		}
	]
}
